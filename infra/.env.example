# Copy to infra/.env on the server and fill in. Never commit the real .env file.

# Your domain, pointed at this server (A/AAAA records for @ and www)
SITE_DOMAIN=cimphawng.com

# A long random password, e.g. from:  openssl rand -base64 32
POSTGRES_PASSWORD=change-me

# Your wallet address(es), comma-separated, for the "owner" role
OWNER_ADDRESSES=
