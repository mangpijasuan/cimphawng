{
  "about": "The same swaps, run through both paper-trading backends (server/ in Python, hosted/ on the Worker). Each case starts from a fresh account holding `start` (or the case's own `balances`) at `prices`, makes one swap, and must end exactly as `expect` says. Amounts are exact decimal strings. A status list means any of those. A rejected swap must leave the balances alone and record no trade. If a rule changes (fee, minimum, rounding), change it in both backends and update this file once.",
  "prices": {"ETH": "2000", "cbBTC": "60000"},
  "start": {"USDC": "100", "ETH": "0", "cbBTC": "0"},
  "cases": [
    {"name": "buy ETH with 50 USDC", "from": "USDC", "to": "ETH", "amount": "50", "expect": {"status": 200, "amount_out": "0.024925", "fee_usd": "0.15", "price_in_usd": "1", "price_out_usd": "2000", "balances": {"USDC": "50", "ETH": "0.024925"}, "trades": 1}},
    {"name": "buy cbBTC with all 100 USDC (result is cut off at 18 decimals, never rounded up)", "from": "USDC", "to": "cbBTC", "amount": "100", "expect": {"status": 200, "amount_out": "0.001661666666666666", "fee_usd": "0.3", "price_in_usd": "1", "price_out_usd": "60000", "balances": {"USDC": "0", "cbBTC": "0.001661666666666666"}, "trades": 1}},
    {"name": "sell 1.5 ETH for USDC", "balances": {"USDC": "0", "ETH": "1.5", "cbBTC": "0"}, "from": "ETH", "to": "USDC", "amount": "1.5", "expect": {"status": 200, "amount_out": "2991", "fee_usd": "9", "price_in_usd": "2000", "price_out_usd": "1", "balances": {"USDC": "2991"}, "trades": 1}},
    {"name": "sell cbBTC for ETH", "balances": {"USDC": "0", "ETH": "0", "cbBTC": "0.5"}, "from": "cbBTC", "to": "ETH", "amount": "0.5", "expect": {"status": 200, "amount_out": "14.955", "fee_usd": "90", "price_in_usd": "60000", "price_out_usd": "2000", "balances": {"USDC": "0", "ETH": "14.955"}, "trades": 1}},
    {"name": "the smallest allowed trade, $0.01", "from": "USDC", "to": "ETH", "amount": "0.01", "expect": {"status": 200, "amount_out": "0.000004985", "fee_usd": "0.00003", "price_in_usd": "1", "price_out_usd": "2000", "balances": {"USDC": "99.99", "ETH": "0.000004985"}, "trades": 1}},
    {"name": "18 decimal places of input", "from": "USDC", "to": "ETH", "amount": "33.333333333333333333", "expect": {"status": 200, "amount_out": "0.016616666666666666", "fee_usd": "0.099999999999999999", "price_in_usd": "1", "price_out_usd": "2000", "balances": {"USDC": "66.666666666666666667", "ETH": "0.016616666666666666"}, "trades": 1}},
    {"name": "an odd amount that does not divide evenly", "from": "USDC", "to": "cbBTC", "amount": "77.777777777777777777", "expect": {"status": 200, "amount_out": "0.001292407407407407", "fee_usd": "0.233333333333333333", "price_in_usd": "1", "price_out_usd": "60000", "balances": {"USDC": "22.222222222222222223", "cbBTC": "0.001292407407407407"}, "trades": 1}},
    {"name": "a large amount", "balances": {"USDC": "1000000000", "ETH": "0", "cbBTC": "0"}, "from": "USDC", "to": "ETH", "amount": "999999999.999999999999999999", "expect": {"status": 200, "amount_out": "498500", "fee_usd": "2999999.999999999999999999", "price_in_usd": "1", "price_out_usd": "2000", "balances": {"USDC": "0.000000000000000001", "ETH": "498500"}, "trades": 1}},
    {"name": "part of a balance", "balances": {"USDC": "0", "ETH": "2", "cbBTC": "0"}, "from": "ETH", "to": "cbBTC", "amount": "0.123456789012345678", "expect": {"status": 200, "amount_out": "0.004102880621510288", "fee_usd": "0.740740734074074068", "price_in_usd": "2000", "price_out_usd": "60000", "balances": {"USDC": "0", "ETH": "1.876543210987654322", "cbBTC": "0.004102880621510288"}, "trades": 1}},
    {"name": "more than the balance, by one unit", "from": "USDC", "to": "ETH", "amount": "100.000000000000000001", "expect": {"status": 400, "balances": {"USDC": "100"}, "trades": 0}},
    {"name": "selling a coin you do not hold", "from": "ETH", "to": "USDC", "amount": "1", "expect": {"status": 400, "balances": {"USDC": "100"}, "trades": 0}},
    {"name": "the same asset on both sides", "from": "USDC", "to": "USDC", "amount": "5", "expect": {"status": 400, "balances": {"USDC": "100"}, "trades": 0}},
    {"name": "an asset that is not tradable", "from": "USDC", "to": "CIMP", "amount": "5", "expect": {"status": 400, "balances": {"USDC": "100"}, "trades": 0}},
    {"name": "just under the $0.01 minimum", "from": "USDC", "to": "ETH", "amount": "0.009999999999999999", "expect": {"status": 400, "balances": {"USDC": "100"}, "trades": 0}},
    {"name": "zero", "from": "USDC", "to": "ETH", "amount": "0", "expect": {"status": [400, 422], "balances": {"USDC": "100"}, "trades": 0}},
    {"name": "negative", "from": "USDC", "to": "ETH", "amount": "-1", "expect": {"status": [400, 422], "balances": {"USDC": "100"}, "trades": 0}},
    {"name": "not a number", "from": "USDC", "to": "ETH", "amount": "abc", "expect": {"status": [400, 422], "balances": {"USDC": "100"}, "trades": 0}},
    {"name": "exponent form", "from": "USDC", "to": "ETH", "amount": "1e2", "expect": {"status": [400, 422], "balances": {"USDC": "100"}, "trades": 0}},
    {"name": "NaN", "from": "USDC", "to": "ETH", "amount": "NaN", "expect": {"status": [400, 422], "balances": {"USDC": "100"}, "trades": 0}},
    {"name": "19 decimal places", "from": "USDC", "to": "ETH", "amount": "1.1234567890123456789", "expect": {"status": [400, 422], "balances": {"USDC": "100"}, "trades": 0}},
    {"name": "no leading digit", "from": "USDC", "to": "ETH", "amount": ".5", "expect": {"status": [400, 422], "balances": {"USDC": "100"}, "trades": 0}},
    {"name": "trailing dot", "from": "USDC", "to": "ETH", "amount": "5.", "expect": {"status": [400, 422], "balances": {"USDC": "100"}, "trades": 0}},
    {"name": "plus sign", "from": "USDC", "to": "ETH", "amount": "+5", "expect": {"status": [400, 422], "balances": {"USDC": "100"}, "trades": 0}},
    {"name": "padded with spaces", "from": "USDC", "to": "ETH", "amount": " 5 ", "expect": {"status": [400, 422], "balances": {"USDC": "100"}, "trades": 0}},
    {"name": "a JSON number instead of a string", "from": "USDC", "to": "ETH", "amount": 5, "expect": {"status": [400, 422], "balances": {"USDC": "100"}, "trades": 0}},
    {"name": "prices with 18 decimals: sell ETH", "prices": {"ETH": "3456.789012345678901234", "cbBTC": "97123.456789012345678901"}, "balances": {"USDC": "0", "ETH": "5", "cbBTC": "0"}, "from": "ETH", "to": "USDC", "amount": "0.123456789012345678", "expect": {"status": 200, "amount_out": "425.483779542083213394", "fee_usd": "1.280292215272065837", "price_in_usd": "3456.789012345678901234", "price_out_usd": "1", "balances": {"USDC": "425.483779542083213394", "ETH": "4.876543210987654322"}, "trades": 1}},
    {"name": "prices with 18 decimals: buy cbBTC", "prices": {"ETH": "3456.789012345678901234", "cbBTC": "97123.456789012345678901"}, "from": "USDC", "to": "cbBTC", "amount": "33.333333333333333333", "expect": {"status": 200, "amount_out": "0.000342176178979381", "fee_usd": "0.099999999999999999", "price_in_usd": "1", "price_out_usd": "97123.456789012345678901", "balances": {"USDC": "66.666666666666666667", "cbBTC": "0.000342176178979381"}, "trades": 1}},
    {"name": "prices with 18 decimals: ETH for cbBTC", "prices": {"ETH": "3456.789012345678901234", "cbBTC": "97123.456789012345678901"}, "balances": {"USDC": "0", "ETH": "2", "cbBTC": "0"}, "from": "ETH", "to": "cbBTC", "amount": "1.999999999999999999", "expect": {"status": 200, "amount_out": "0.070969851346941307", "fee_usd": "20.740734074074073397", "price_in_usd": "3456.789012345678901234", "price_out_usd": "97123.456789012345678901", "balances": {"USDC": "0", "ETH": "0.000000000000000001", "cbBTC": "0.070969851346941307"}, "trades": 1}},
    {"name": "prices with 18 decimals: a large sell", "prices": {"ETH": "3456.789012345678901234", "cbBTC": "97123.456789012345678901"}, "balances": {"USDC": "0", "ETH": "0", "cbBTC": "123456789.123456789123456789"}, "from": "cbBTC", "to": "ETH", "amount": "123456789.123456789123456789", "expect": {"status": 200, "amount_out": "3458289884.246941757194643387", "fee_usd": "35971650371.226794407852221898", "price_in_usd": "97123.456789012345678901", "price_out_usd": "3456.789012345678901234", "balances": {"USDC": "0", "ETH": "3458289884.246941757194643387"}, "trades": 1}}
  ]
}
